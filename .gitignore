__pycache__/
*.pyc

# Built C accelerator (simulation/_fastplot). Optional and machine-specific:
# build it with `python3 tools/build_fastplot.py`, never commit the binary.
# The .incoming-* form is that builder's staging path -- it swaps atomically
# into place on success, but a killed build can leave one behind.
*.so
*.so.incoming-*
build/
.pytest_cache/
.ruff_cache/
.DS_Store

# Batch output. The five top-level names are symlinks through reports/latest
# into an immutable reports/runs/<id>/ directory -- see _publish_report_artifacts
# in main.py. reports/.batch-*/ is publication staging: normally renamed into
# runs/ on success, but an interrupted batch can leave one behind (they hold a
# partial run_results.csv, which gets large).
reports/*.csv
reports/*.json
reports/*.md
reports/*.html
reports/charts/
reports/auto_balance/
reports/runs/
reports/latest
reports/.batch-*/
reports/.publish.lock

# Scratch output from `make sim`/`charts`/`balance` (tools/scratch_run.py) --
# same REPORTS_DIR layout as above, isolated under its own root so it never
# touches the real reports/ tree.
reports/_scratch/

# Batch output tree is fully generated (the specific globs above predate
# this and are kept for clarity/history); ignore the whole directory so
# nothing under it -- including reports/.DS_Store and reports/.publish.lock
# -- is ever a candidate for a commit.
reports/

# Local Claude Code permission grants -- machine-specific, not shared.
.claude/settings.local.json

# uv lockfile: incidental residue from running `uv run` locally. pyproject.toml
# has no [project] table (see its own header comment) and the Makefile drives
# everything through python3, not uv, so there's nothing for this to lock.
uv.lock
